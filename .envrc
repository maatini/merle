# Merle Development Environment
# Requires: direnv (https://direnv.net) + devbox (https://www.jetify.com/devbox)
#
# Setup once:
#   brew install direnv devbox     (macOS)
#   # or appropriate package manager for your OS
#   direnv allow .
#
# Then: simply `cd /path/to/merle` → Devbox environment is loaded automatically.
# No more "which python", version conflicts, or missing tools.

use devbox

# Optional: tell uv to use the project .venv even when other pythons are around
export UV_PROJECT_ENVIRONMENT=".venv"

# Make the Merle CLI available immediately (after first uv sync)
PATH_add .venv/bin

# Friendly hint (only on first load)
if [ -z "$DEVBOX_SHELL_ENABLED" ]; then
  echo "✅ Merle Devbox + direnv aktiviert (Python 3.11 + uv + pre-commit + Node 20)"
fi
