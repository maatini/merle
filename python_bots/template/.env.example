# Merle Bot – Environment Configuration (12-Factor)
# Kopiere diese Datei nach .env und passe die Werte an.
# .env wird niemals committet!

# ── Allgemein ─────────────────────────────────────────────────────────────
BOT_BOT_NAME=template_bot
BOT_ENVIRONMENT=development          # development | staging | production

# ── Logging ───────────────────────────────────────────────────────────────
BOT_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
BOT_LOG_JSON=false                   # true → zusätzliche JSON-Logs in logs/

# ── Retry & HTTP ──────────────────────────────────────────────────────────
BOT_MAX_RETRIES=3
BOT_REQUEST_TIMEOUT=30.0

# ── Zielsystem (anpassen!) ────────────────────────────────────────────────
BOT_TARGET_URL=https://example.com/api
BOT_API_KEY=                           # niemals ins Git!

# ── UiPath Orchestrator (optional – nur bei Bedarf) ───────────────────────
# BOT_ORCHESTRATOR_URL=https://orchestrator.company.com
# BOT_ORCHESTRATOR_TENANT=Default
# BOT_ORCHESTRATOR_CLIENT_ID=
# BOT_ORCHESTRATOR_CLIENT_SECRET=
