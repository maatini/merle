# Umgebungsvariablen für den Template-Bot
# Kopiere diese Datei nach .env und passe die Werte an

# Allgemein
BOT_BOT_NAME=template_bot
BOT_ENVIRONMENT=development

# Logging
BOT_LOG_LEVEL=INFO
BOT_LOG_JSON=false

# Retry & Timeout
BOT_MAX_RETRIES=3
BOT_REQUEST_TIMEOUT=30.0

# Zielsystem
BOT_TARGET_URL=https://example.com/api
BOT_API_KEY=

# UiPath Orchestrator (optional)
BOT_ORCHESTRATOR_URL=
BOT_ORCHESTRATOR_TENANT=Default
BOT_ORCHESTRATOR_CLIENT_ID=
BOT_ORCHESTRATOR_CLIENT_SECRET=
