# syntax=docker/dockerfile:1
#
# {{ bot_name }} — Professional Merle Bot Dockerfile
# Generated by Copier (Professional Foundation v0.2+)
#
# Recommended build commands:
#
# Monorepo (most common during development):
#   docker build -f python_bots/{{ bot_name }}/Dockerfile \
#     --build-arg BUILD_MODE=monorepo \
#     -t {{ bot_name }}:latest .
#   (Run this from the Merle repository root)
#
# Standalone (when merle-core is published to an internal index):
#   cd python_bots/{{ bot_name }}
#   docker build -f Dockerfile --build-arg BUILD_MODE=standalone -t {{ bot_name }}:latest .
#

ARG PYTHON_VERSION={{ python_version }}
ARG BUILD_MODE=monorepo

# =============================================================================
# Builder
# =============================================================================
FROM python:${PYTHON_VERSION}-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Copy dependency specification
COPY pyproject.toml uv.lock ./

# === Monorepo support for merle-core ===
# When building with BUILD_MODE=monorepo (from repo root), we copy the core package
# so that the path dependency in pyproject.toml works inside the container.
COPY python_bots/shared ./python_bots/shared

# Install production dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-cache

# =============================================================================
# Runtime (distroless-like, non-root)
# =============================================================================
FROM python:${PYTHON_VERSION}-slim AS runtime

ARG BUILD_MODE

# Security: non-root user
RUN groupadd --system --gid 1000 bot && \
    useradd --system --uid 1000 --gid bot --home /app --shell /sbin/nologin bot

# Copy uv for the entrypoint
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv

# Browser runtime dependencies (engine-aware)
{% if include_playwright and browser_engine == "chromium" %}
# Schwere Chromium-Abhängigkeiten (nur bei chromium nötig)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates fonts-liberation \
        libglib2.0-0 libnss3 libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*
{% elif include_playwright and browser_engine == "lightpanda" %}
# Minimal für Lightpanda (Zig-Binary wird von lightpanda-py heruntergeladen)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
{% endif %}

WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BUILD_MODE=${BUILD_MODE}

# Copy the application (respect .dockerignore)
COPY --chown=bot:bot . .

USER bot

# Health check (override in real bots with something meaningful)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "print('healthy')" || exit 1

ENTRYPOINT ["uv", "run", "python", "main.py"]
