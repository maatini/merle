async def main() -> None:
    """Haupt-Workflow des Bots."""
    settings = BotSettings()  # type: ignore[call-arg]

    # === Phase 2: Observability aktivieren ===
    from merle_core.observability import configure_observability
    configure_observability(service_name=settings.bot_name)

    setup_logging(level=settings.log_level, json_format=settings.log_json)

    logger.info("Bot {} startet (env={})", settings.bot_name, settings.environment)

    try:
        {% if use_base_bot_class %}
        # Moderne Architektur: Von BaseBot erben
        # from merle_core import BaseBot
        # bot = MeinBot(settings)
        # await bot.run()
        {% endif %}

        {% if include_playwright or include_pandas or include_pdf %}
        # Tasks von BaseTask erben (empfohlen)
        task = ExampleTask(settings)
        result = await task.run()
        logger.info("Task abgeschlossen: {}", result)
        {% else %}
        logger.info("Bot erfolgreich ausgeführt (Platzhalter – eigene Logik hier einfügen)")
        {% endif %}

    except Exception:
        logger.exception("Kritischer Fehler im Bot")
        raise


if __name__ == "__main__":
    asyncio.run(main())
