{% if use_base_bot_class %}
class {{ bot_name | replace("_", " ") | title | replace(" ", "") }}Bot(BaseBot):
    """
    Main orchestrator for {{ bot_name }}.

    Follows the Merle 2026 pattern:
    - Clean inheritance from BaseBot
    - execute() contains the high-level pipeline
    - Real work is delegated to typed BaseTask classes
    """

    def __init__(self, settings: BotSettings) -> None:
        # Use the new ergonomic BaseBot API (name= is optional but recommended)
        super().__init__(settings, name="{{ bot_name }}")

    async def execute(self) -> dict[str, any]:
        """High-level pipeline. Called by BaseBot.run()."""
        self.logger.info("Starting {{ bot_name }} pipeline (env={})", self.settings.environment)

        results: dict[str, any] = {}

        {% if include_playwright or include_pandas or include_pdf %}
        # Example: run one or more tasks (extend this in real bots)
        task = ExampleTask(self.settings)
        task_result = await task.run()
        results["example_task"] = task_result
        {% else %}
        self.logger.info("No feature flags selected — add your tasks here")
        results["status"] = "placeholder"
        {% endif %}

        self.logger.success("Pipeline completed")
        return results

    def _on_success(self, result: dict[str, any]) -> None:
        """Hook: runs after successful execution (metrics, notifications, etc.)."""
        self.logger.success("{{ bot_name }} finished successfully")

    def _on_failure(self, exception: Exception) -> None:
        """Hook: escalation, alerting, dead-letter, self-healing."""
        self.logger.error("{{ bot_name }} failed: {}", exception)


async def main() -> None:
    settings = BotSettings()

    # Observability (safe — won't crash the bot if OTEL is not fully available)
    try:
        from merle_core.observability import configure_observability
        configure_observability(
            service_name=settings.bot_name,
            service_version="0.1.0",
            enable_tracing=True,
            enable_metrics=False,
            resource_attributes={"deployment.environment": settings.environment},
        )
    except Exception as exc:
        logger.warning("Observability setup skipped: {}", exc)

    setup_logging(level=settings.log_level, json_format=settings.log_json)

    bot = {{ bot_name | replace("_", " ") | title | replace(" ", "") }}Bot(settings)

    # BaseBot.run() gives you: timing, structured logging, hooks, metrics, status
    result = await bot.run()

    logger.info("Final result: {}", result)
    logger.info("Health: {}", bot.health_check())


