[project]
name = "{{ bot_name }}"
version = "0.1.0"
description = "{{ bot_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = {text = "Proprietary"}

dependencies = [
    # merle-core with relevant extras (BaseBot + observability always included)
    "merle-core[observability{% if include_pandas or include_pdf %},data{% endif %}{% if include_playwright and browser_engine == 'chromium' %},playwright{% endif %}{% if include_playwright and browser_engine == 'lightpanda' %},lightpanda{% endif %}]",

    "pydantic-settings>=2.0,<3.0",
    "loguru>=0.7,<1.0",
    "tenacity>=8.0,<9.0",
    "httpx>=0.25,<1.0",

    {% if include_pandas %}
    "pandas>=2.0,<3.0",
    "openpyxl>=3.1,<4.0",
    {% endif %}

    {% if include_pdf %}
    "pdfplumber>=0.10,<1.0",
    {% endif %}

    {% if include_playwright and browser_engine == "chromium" %}
    "playwright>=1.40,<2.0",
    {% elif include_playwright and browser_engine == "lightpanda" %}
    "lightpanda-py>=0.2.0,<1.0",
    "playwright-core>=1.40,<2.0",
    {% endif %}

    {% if include_uipath_orchestrator %}
    # UiPath Orchestrator REST Client (wird bei Bedarf erweitert)
    {% endif %}
]

[tool.uv.sources]
{% if location == "python_bots" %}
# Entwicklung innerhalb des Merle-Monorepos
merle-core = { path = "../shared" }
{% else %}
# Standalone-Modus (später internes PyPI oder git+...)
merle-core = ">=0.1.0"
{% endif %}

[dependency-groups]
dev = [
    "ruff>=0.9,<1.0",
    "mypy>=1.14,<2.0",
    "pytest>=8.0,<9.0",
    "pytest-asyncio>=0.23,<1.0",
    {% if include_playwright and browser_engine == "chromium" %}
    "pytest-playwright>=0.4,<1.0",
    {% endif %}
]

# Tooling (kann bei Bedarf aus Root-Workspace vererbt werden)

[tool.ruff]
target-version = "py{{ python_version.replace('.', '') }}"
line-length = 120

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "RUF", "T20", "PT"]
ignore = ["E501", "B008"]

[tool.ruff.format]
quote-style = "double"

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
warn_unused_configs = true
ignore_missing_imports = true

[tool.pytest.ini_options]
minversion = "8.0"
addopts = ["--strict-markers", "--strict-config", "-ra"]
asyncio_mode = "auto"
testpaths = ["tests"]
